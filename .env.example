# Solana Alpha Engine — Beispielkonfiguration
#
# Diese Datei enthaelt AUSSCHLIESSLICH Variablennamen, niemals Werte.
# Echte Werte kommen aus dem Secret-Manager bzw. aus Docker Secrets.
# Der private Schluessel taucht hier bewusst nicht auf: er existiert nur als
# Docker-Secret und wird ausschliesslich in den Signer-Container gemountet.

# --- Gemeinsam ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://sae:CHANGE_ME@localhost:5432/sae
REDIS_URL=redis://localhost:6379

# --- Worker ---
# Eine Rolle je Container. Drei davon laufen heute mit echter Fachlogik:
#   scheduler       — reiht faellige Auftraege in die dauerhafte Queue ein
#   consumer        — zieht Auftraege und fuehrt sie aus (Retry, Dead Letter)
#   provider-health — misst im Minutentakt, ob eine Datenquelle antwortet
# Die uebrigen sind Platzhalter, bis eine Marktdatenquelle erreichbar ist:
#   discovery | enrichment | scoring | decision | execution | positions |
#   paper | reconciler | alerts
WORKER_ROLE=provider-health
HEALTH_PORT=3001
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=

# Nur der execution-Worker. Erreichbar ausschliesslich im internen Docker-Netz.
SIGNER_URL=
SIGNER_CLIENT_CERT_PATH=
SIGNER_CLIENT_KEY_PATH=

# --- Web (laeuft auf Vercel) ---
APP_BASE_URL=http://localhost:3000
# Mindestens 32 Zeichen. Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=
#
# WICHTIG fuer Vercel: DATABASE_URL muss auf einen POOLER zeigen
# (Neon pooled endpoint, Supabase :6543, PgBouncer im Transaction Mode).
# Jede Serverless-Instanz haelt einen eigenen kleinen Pool; ohne Pooler davor
# laeuft die Datenbank unter Last in "too many connections".
# Siehe docs/DEPLOYMENT.md, Abschnitt „Datenbank".

# --- Datenquellen ---
#
# Nur Basis-URLs, niemals Endpunktpfade: einen Pfad zu konfigurieren hiesse,
# ihn zu kennen. Bekannt ist bislang genau einer (Jupiter, aus dessen eigener
# OpenAPI-Spezifikation). Ein Anbieter ohne Eintrag ist NOT_CONFIGURED — das
# ist eine Feststellung, kein Fehler.
#
# Reihenfolge der Marktdatenquellen, komma-getrennt.
# Erste = PRIMARY, zweite = SECONDARY, Rest = FALLBACK.
# Beispiel: MARKET_DATA_PRIORITY=dexscreener,birdeye
MARKET_DATA_PRIORITY=

# DexScreener braucht keine Auth. Der Host muss aber in der Egress-Allowlist
# der Umgebung stehen, sonst antwortet der Proxy mit 403.
DEXSCREENER_BASE_URL=
BIRDEYE_BASE_URL=
BIRDEYE_API_KEY=
JUPITER_BASE_URL=
HELIUS_BASE_URL=
HELIUS_API_KEY=
RUGCHECK_BASE_URL=

# --- Alerts (Resend) ---
#
# Ohne RESEND_API_KEY sendet der Adapter nichts und meldet NOT_CONFIGURED.
# Der Schluessel steht ausschliesslich in dieser Variablen, niemals im Code
# und niemals in einem Log.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
# Erlaubt den Versand von Mails aus TEST_FIXTURE-Gelegenheiten.
# Sie tragen dann sichtbar [TEST] im Betreff. Im Betrieb: leer lassen.
ALERT_ALLOW_TEST_EMAILS=

# --- Signer (nur im Signer-Container) ---
SIGNER_PORT=8443
SIGNER_KEY_FILE=/run/secrets/signer_key
SIGNER_TLS_CERT_PATH=/run/secrets/signer_tls_cert
SIGNER_TLS_KEY_PATH=/run/secrets/signer_tls_key
SIGNER_TLS_CLIENT_CA_PATH=/run/secrets/signer_client_ca
SIGNER_TRADING_WALLET=
# Komma-getrennt. Alles, was nicht hier steht, wird nicht signiert.
SIGNER_ALLOWED_PROGRAM_IDS=
SIGNER_ALLOWED_TIP_ACCOUNTS=
# Harte Obergrenzen des SOL-Abflusses, in Lamports (1 SOL = 1000000000).
SIGNER_MAX_SOL_OUT_PER_TX_LAMPORTS=500000000
SIGNER_MAX_SOL_OUT_PER_WINDOW_LAMPORTS=2000000000
SIGNER_WINDOW_SECONDS=3600
