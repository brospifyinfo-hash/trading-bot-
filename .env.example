# Solana Alpha Engine — Beispielkonfiguration
#
# Diese Datei enthaelt AUSSCHLIESSLICH Variablennamen, niemals Werte.
# Echte Werte kommen aus dem Secret-Manager bzw. aus Docker Secrets.
# Der private Schluessel taucht hier bewusst nicht auf: er existiert nur als
# Docker-Secret und wird ausschliesslich in den Signer-Container gemountet.

# --- Gemeinsam ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://sae:CHANGE_ME@localhost:5432/sae
REDIS_URL=redis://localhost:6379

# --- Worker ---
# Eine Rolle je Container: discovery | enrichment | scoring | decision |
# execution | positions | paper | reconciler | alerts | scheduler
WORKER_ROLE=scoring
HEALTH_PORT=3001
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=

# Nur der execution-Worker. Erreichbar ausschliesslich im internen Docker-Netz.
SIGNER_URL=
SIGNER_CLIENT_CERT_PATH=
SIGNER_CLIENT_KEY_PATH=

# --- Web ---
APP_BASE_URL=http://localhost:3000
# Mindestens 32 Zeichen. Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=

# --- Alerts ---
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=

# --- Signer (nur im Signer-Container) ---
SIGNER_PORT=8443
SIGNER_KEY_FILE=/run/secrets/signer_key
SIGNER_TLS_CERT_PATH=/run/secrets/signer_tls_cert
SIGNER_TLS_KEY_PATH=/run/secrets/signer_tls_key
SIGNER_TLS_CLIENT_CA_PATH=/run/secrets/signer_client_ca
SIGNER_TRADING_WALLET=
# Komma-getrennt. Alles, was nicht hier steht, wird nicht signiert.
SIGNER_ALLOWED_PROGRAM_IDS=
SIGNER_ALLOWED_TIP_ACCOUNTS=
# Harte Obergrenzen des SOL-Abflusses, in Lamports (1 SOL = 1000000000).
SIGNER_MAX_SOL_OUT_PER_TX_LAMPORTS=500000000
SIGNER_MAX_SOL_OUT_PER_WINDOW_LAMPORTS=2000000000
SIGNER_WINDOW_SECONDS=3600
