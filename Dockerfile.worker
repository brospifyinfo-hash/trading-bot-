# Container fuer den dauerhaft laufenden Worker.
#
# Ein Image, viele Rollen: die Rolle kommt zur Laufzeit aus WORKER_ROLE. Das
# haelt die Deploy-Matrix klein und garantiert, dass alle Rollen denselben Code
# teilen — getrennte Images driften auseinander.
#
# Bauen (aus dem Repository-Wurzelverzeichnis):
#   docker build -f Dockerfile.worker -t sae-worker .
#
# Starten:
#   docker run --rm \
#     -e DATABASE_URL=... -e REDIS_URL=... -e SOLANA_RPC_URL=... \
#     -e WORKER_ROLE=scheduler -p 3001:3001 sae-worker
#
# Laeuft auf jedem Host, der ein OCI-Image annimmt: Fly.io, Railway, Render,
# Hetzner mit Docker, ECS. Ausdruecklich NICHT auf Vercel — die Begruendung
# steht in docs/DEPLOYMENT.md, Abschnitt 2.

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# corepack liefert exakt die im Repository festgelegte pnpm-Version.
RUN corepack enable

WORKDIR /app

# ---------------------------------------------------------------- Abhaengigkeiten
# Erst nur die Manifeste kopieren: solange sich keine Abhaengigkeit aendert,
# bleibt diese Schicht im Cache und ein Rebuild dauert Sekunden statt Minuten.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY apps/signer/package.json apps/signer/
COPY packages/ packages/
# --frozen-lockfile: ein Build, der die Lockfile stillschweigend aendert, ist
# nicht derselbe Build wie der gepruefte.
RUN pnpm install --frozen-lockfile --ignore-scripts

# ---------------------------------------------------------------- Laufzeit
FROM base AS runtime
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/worker ./apps/worker

# Die Pakete werden als TypeScript-Quellen eingebunden; tsx fuehrt sie direkt
# aus. Ein eigener Build-Schritt existiert bewusst nicht — er waere eine
# zweite Wahrheit neben dem, was Tests und Typecheck pruefen.
RUN pnpm install --frozen-lockfile --ignore-scripts --filter @sae/worker...

# Nicht als root laufen: ein Prozess mit Datenbankzugriff braucht keine
# Rechte am Dateisystem des Containers.
RUN useradd --create-home --shell /bin/bash worker \
 && chown -R worker:worker /app
USER worker

# Der Health-Port ist der einzige, den dieser Container oeffnet. Er dient dem
# Host zum Prueflauf, nicht der Kommunikation mit Vercel — die laeuft
# ausschliesslich ueber die Datenbank.
ENV HEALTH_PORT=3001
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.HEALTH_PORT||3001)+'/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# WORKER_ROLE wird bewusst NICHT gesetzt: ein Container ohne ausdrueckliche
# Rolle soll sichtbar nicht starten, statt stillschweigend eine falsche zu
# uebernehmen.
WORKDIR /app/apps/worker
CMD ["pnpm", "start"]
