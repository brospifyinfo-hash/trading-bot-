# Container fuer den dauerhaft laufenden Worker.
#
# Ein Image, viele Rollen: die Rolle kommt zur Laufzeit aus WORKER_ROLE. Das
# haelt die Deploy-Matrix klein und garantiert, dass alle Rollen denselben Code
# teilen — getrennte Images driften auseinander.
#
# Bauen (aus dem Repository-Wurzelverzeichnis):
#   docker build -f Dockerfile.worker -t sae-worker .
#
# Starten:
#   docker run --rm \
#     -e DATABASE_URL=... -e SOLANA_RPC_URL=... -e WORKER_ROLE=scheduler \
#     -p 3001:3001 sae-worker
#
# Laeuft auf jedem Host, der ein OCI-Image annimmt: Railway (siehe
# railway/README.md), Fly.io, Render, Hetzner mit Docker. Ausdruecklich NICHT
# auf Vercel — Begruendung in docs/DEPLOYMENT.md, Abschnitt 2.

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# corepack liefert exakt die in package.json festgelegte pnpm-Version.
RUN corepack enable
WORKDIR /app

# ---------------------------------------------------------------- Bauen
FROM base AS build

# Erst die Manifeste: solange sich keine Abhaengigkeit aendert, bleibt die
# Installationsschicht im Cache und ein Rebuild dauert Sekunden.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# apps/web und apps/signer werden im Worker-Image nicht ausgefuehrt, ihre
# Manifeste muessen aber vorhanden sein: `pnpm-workspace.yaml` erfasst `apps/*`,
# und `--frozen-lockfile` vergleicht die Lockfile gegen ALLE Arbeitsbereiche.
# Fehlt eines, bricht die Installation mit "lockfile is not up to date" ab.
COPY apps/web/package.json apps/web/
COPY apps/signer/package.json apps/signer/

# Die internen Pakete werden als TypeScript-Quellen eingebunden, deshalb
# vollstaendig und nicht nur ihre Manifeste.
COPY packages/ packages/
COPY apps/worker/ apps/worker/

# --ignore-scripts: keine Postinstall-Skripte fremder Pakete im Build.
# Genau eine Installation im gesamten Dockerfile — eine zweite gegen einen
# unvollstaendigen Arbeitsbereich waere der wahrscheinlichste Grund fuer einen
# fehlschlagenden Build.
RUN pnpm install --frozen-lockfile --ignore-scripts

# ---------------------------------------------------------------- Laufzeit
FROM base AS runtime
ENV NODE_ENV=production

# pnpm verlinkt Abhaengigkeiten quer durch den Arbeitsbereich (Wurzel-
# `node_modules` plus je Paket). Deshalb wird der Baum als Ganzes uebernommen —
# einzelne Verzeichnisse zu kopieren zerreisst die Verlinkung.
COPY --from=build /app /app

# pnpm ins Image legen, statt es bei jedem Start zu holen.
#
# Ohne diese Zeile laedt corepack die pnpm-Datei bei JEDEM Containerstart neu
# von registry.npmjs.org — sichtbar als rote Warnzeile im Log:
#
#   ! Corepack is about to download .../pnpm-10.33.0.tgz
#
# Der Start haengt damit an einem fremden Dienst, obwohl alles Noetige schon
# im Image liegt. Ist die Registry langsam oder weg, startet der Worker nicht,
# und der Fehler sieht aus wie ein Anwendungsproblem.
#
# `corepack prepare` OHNE Versionsangabe liest `packageManager` aus der
# package.json im Arbeitsverzeichnis. Das ist Absicht: eine hier eingetragene
# Version waere eine zweite Stelle, an der die pnpm-Version gepflegt werden
# muesste, und sie liefe beim naechsten Upgrade still auseinander.
#
# COREPACK_HOME muss ein FESTER Pfad sein und nicht die Vorgabe im
# Heimatverzeichnis: dieser Schritt laeuft als root, der Container laeuft als
# `worker`. Ohne gemeinsamen Pfad legte root die Ablage nach /root/.cache, wo
# `worker` sie nicht findet — und corepack laedt beim Start doch wieder.
# Genau diese Falle macht den Unterschied zwischen "behoben" und "sieht
# behoben aus".
ENV COREPACK_HOME=/opt/corepack
RUN corepack prepare --activate

# Nicht als root laufen: ein Prozess mit Datenbankzugriff braucht keine Rechte
# am Dateisystem des Containers.
#
# Die corepack-Ablage gehoert mit uebertragen: corepack schreibt beim Start
# eine `lastKnownGood.json`, und ein Schreibfehler waere derselbe Startabbruch
# wie ein fehlender Download.
RUN useradd --create-home --shell /bin/bash worker \
 && chown -R worker:worker /app /opt/corepack
USER worker

# Der Health-Port ist der einzige, den dieser Container oeffnet. Er dient dem
# Host zum Prueflauf, nicht der Kommunikation mit Vercel — die laeuft
# ausschliesslich ueber die Datenbank.
#
# Railway, Render und Fly setzen `PORT` selbst; der Worker liest ihn vorrangig
# und faellt sonst auf `HEALTH_PORT` und zuletzt auf 3001 zurueck.
ENV HEALTH_PORT=3001
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD node -e "const p=process.env.PORT||process.env.HEALTH_PORT||3001;fetch('http://127.0.0.1:'+p+'/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# WORKER_ROLE wird bewusst NICHT gesetzt: ein Container ohne ausdrueckliche
# Rolle soll sichtbar nicht starten, statt stillschweigend eine falsche zu
# uebernehmen.
WORKDIR /app/apps/worker
CMD ["pnpm", "start"]
