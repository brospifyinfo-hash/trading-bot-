# Ein Image, viele Rollen — die Rolle kommt aus WORKER_ROLE.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/core/package.json packages/core/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/simulation/package.json packages/simulation/
COPY packages/observability/package.json packages/observability/
COPY apps/worker/package.json apps/worker/
RUN pnpm install --frozen-lockfile --filter @sae/worker...

FROM deps AS build
COPY . .
RUN pnpm --filter @sae/worker exec tsc --noEmit \
 && pnpm exec esbuild apps/worker/src/worker.ts \
      --bundle --platform=node --target=node22 --format=esm \
      --outfile=dist/worker.js --packages=external

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/packages/db/migrations ./migrations
# Nicht als root: der Worker braucht keinerlei erhoehte Rechte.
USER node
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD node -e "fetch('http://localhost:'+(process.env.HEALTH_PORT||3001)+'/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/worker.js"]
