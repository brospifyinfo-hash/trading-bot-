{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @sae/web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "regions": ["fra1"],
  "functions": {
    "apps/web/app/**/*": {
      "maxDuration": 15
    }
  }
}
